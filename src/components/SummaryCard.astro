---
interface Props {
  title: string;
  content: number;
}

const { title, content } = Astro.props;
---

<article class="card">
  <div class="card-header">
    <h2 class="card-title">{title}</h2>
    <div class="card-icon">
      <slot name="icon" />
    </div>
  </div>
  <div class="card-content">{content}</div>
</article>

<style>
  .card {
    gap: 8px;
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .card-title {
    margin-block: 0;
  }
  .card-icon {
    transform: translateY(2px);
  }
</style>
