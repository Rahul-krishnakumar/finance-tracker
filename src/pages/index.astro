---
import Layout from "../layouts/Layout.astro";
import { getExpenseData } from "../lib/googleSheets";
import { getCachedData } from "../lib/cache";
import type { Transaction } from "../types/Transaction";
import TransactionTable from "../components/TransactionTable.svelte";

const expenseData = await getCachedData<Transaction>(getExpenseData);
---

<Layout>
  <style>
    table {
      border-width: 2px;
    }
  </style>
  <main>
    <h1>Finance Tracker</h1>
    <TransactionTable transactions={expenseData} client:load />
  </main>
</Layout>
