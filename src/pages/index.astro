---
import Layout from "../layouts/Layout.astro";
import SummaryCard from "../components/SummaryCard.astro";
import CategoryChart from "../components/charts/CategoryChart.svelte";
import TransactionTable from "../components/TransactionTable.svelte";

import { db, Transaction, sql, Configuration, eq } from "astro:db";
import { IndianRupee, TrendingUp, TrendingDown } from "@lucide/svelte";
import { formatCurrency, roundCurrency } from "../lib/utils";
import type { Transaction as ITransaction } from "../types/Transaction";
import SpendingTrendsChart from "../components/charts/SpendingTrendsChart.svelte";

const transactions = (await db
  .select()
  .from(Transaction)) as unknown as ITransaction[];

const stats = await db
  .select({
    income: sql<number>`SUM(CASE WHEN type = 'income' THEN amount ELSE 0 END)`,
    expense: sql<number>`SUM(CASE WHEN type = 'expense' THEN amount ELSE 0 END)`,
  })
  .from(Transaction);

const config = await db
  .select()
  .from(Configuration)
  .where(eq(Configuration.key, "opening-balance"));

const { income, expense } = stats[0];
const openingBalance = Number(config[0]?.value ?? 0);
const balance = roundCurrency(openingBalance + income - expense);
---

<Layout>
  <main>
    <h1>Finance Tracker</h1>
    <div class="summary">
      <SummaryCard title="Income" content={formatCurrency(income)}>
        <TrendingUp color="var(--pico-color-green-500)" size={16} slot="icon" />
      </SummaryCard>
      <SummaryCard title="Expense" content={formatCurrency(expense)}>
        <TrendingDown color="var(--pico-color-red-500)" size={16} slot="icon" />
      </SummaryCard>
      <SummaryCard title="Balance" content={formatCurrency(balance)}>
        <IndianRupee color="var(--pico-primary)" size={16} slot="icon" />
      </SummaryCard>
    </div>
    <div class="charts">
      <CategoryChart transactions={transactions} client:only="svelte" />
      <SpendingTrendsChart transactions={transactions} client:only="svelte" />
    </div>
    <TransactionTable transactions={transactions} client:only="svelte" />
  </main>
</Layout>

<style>
  .summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;

    article {
      margin-block: 0;
    }
  }

  .charts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1rem;
  }
</style>
